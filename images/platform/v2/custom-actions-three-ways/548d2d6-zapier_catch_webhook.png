        window.__fernRuntimeHeadStyleSwapGuardBound = true;
        var PERSIST_ATTR = "data-astro-transition-persist";
        var fromIncoming = new WeakSet();
        var nextId = 0;
        var serverStyles = document.head.querySelectorAll("style");
        for (var k = 0; k < serverStyles.length; k++) {
          fromIncoming.add(serverStyles[k]);
        }
        document.addEventListener("astro:before-swap", function (event) {
          var incomingDocument = event.newDocument;
          var incomingHead = incomingDocument && incomingDocument.head;
          if (!incomingHead) { return; }
          var incomingStyles = incomingHead.querySelectorAll("style");
          var incomingTexts = Object.create(null);
          for (var i = 0; i < incomingStyles.length; i++) {
            fromIncoming.add(incomingStyles[i]);
            incomingTexts[incomingStyles[i].textContent] = true;
          }
          var liveStyles = document.head.querySelectorAll("style");
          for (var j = 0; j < liveStyles.length; j++) {
            var el = liveStyles[j];
            if (
              fromIncoming.has(el) ||
              el.hasAttribute("data-styled-jsx") ||
              el.hasAttribute("data-vite-dev-id") ||
              incomingTexts[el.textContent] === true
