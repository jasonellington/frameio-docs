      (function () {
        // Only write when the value changes: every write restyles the whole
        // document. The ResizeObserver path reads `contentRect` after layout
        // instead of forcing a synchronous layout before first paint.
        function applyHeaderHeight(height) {
          var value = height + "px";
          if (document.documentElement.style.getPropertyValue("--header-height") !== value) {
            document.documentElement.style.setProperty("--header-height", value);
          }
        }
        function syncHeaderHeight() {
          var header = document.getElementById("fern-header");
          if (header) {
            var style = window.getComputedStyle(header);
            applyHeaderHeight(header.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom));
          }
        }
        var ro;
        function setup() {
          var header = document.getElementById("fern-header");
          if (header && "ResizeObserver" in window) {
            if (ro) { ro.disconnect(); }
            ro = new ResizeObserver(function (entries) {
              var entry = entries[entries.length - 1];
              if (entry) { applyHeaderHeight(entry.contentRect.height); }
            });
            ro.observe(header);
          } else {
            (window.requestAnimationFrame || window.setTimeout)(syncHeaderHeight);
          }
        }
        setup();
        if (!window.__fernHeaderHeightBound) {
          window.__fernHeaderHeightBound = true;
          document.addEventListener("astro:page-load", setup);
          // The swap replaces <html>'s attributes (including the inline style
          // holding the synced value), so carry it over to the incoming document
          // or the header/main/sidebar briefly snap to the stylesheet fallback.
          document.addEventListener("astro:before-swap", function (event) {
            var current = document.documentElement.style.getPropertyValue("--header-height");
            if (current && event.newDocument) {
              event.newDocument.documentElement.style.setProperty("--header-height", current);
            }
          });
        }
      })();
    </script><!-- Main (matches MainElement) --><main class="fern-main relative z-0 flex transition-all duration-500 ease-out mt-(--header-height)" data-theme="default" data-fern-style="transition: max-width 500ms ease-out"><a href="#fern-sidebar" class="sr-only max-lg:hidden focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:border-border-concealed focus:bg-(color:--background) focus:px-4 focus:py-2 focus:text-body focus:no-underline focus:shadow-md">Skip to navigation</a><div id="fern-sidebar-spacer" data-state="sticky"></div><!-- Page content is an Astro slot, so the shared layout wrappers are mirrored here while their stateful components are reused directly. --><div class="width-before-scroll-bar w-screen"><astro-island uid="2385NS" prefix="r13" component-url="/_astro/layout.tf7IF8i2.js" component-export="SetLayout" renderer-url="/_astro/client.DO4ZZsz0.js" props="{&quot;value&quot;:[0,&quot;custom&quot;]}" ssr client="idle" opts="{&quot;name&quot;:&quot;SetLayout&quot;,&quot;value&quot;:true}"></astro-island><astro-island uid="2ebfnv" prefix="r14" component-url="/_astro/HiddenSidebar.EO4TL4Ex.js" component-export="HiddenSidebar" renderer-url="/_astro/client.DO4ZZsz0.js" props="{}" ssr client="idle" opts="{&quot;name&quot;:&quot;HiddenSidebar&quot;,&quot;value&quot;:true}" await-children><style>#fern-toc,#fern-sidebar[data-state="sticky"],#fern-sidebar[data-state="fixed"],#fern-sidebar-spacer{visibility:hidden;width:0;overflow:hidden;display:none;}.fern-main:has(>#fern-sidebar[data-viewport="desktop"][data-state="sticky"]){min-height:0!important;}</style><!--astro:end--></astro-island><astro-island uid="JPPsu" prefix="r9" component-url="/_astro/NotFoundIsland.BFgQe2Nv.js" component-export="default" renderer-url="/_astro/client.DO4ZZsz0.js" props="{&quot;defaultLocale&quot;:[0,&quot;en-US&quot;],&quot;translations&quot;:[1,[[0,&quot;en-US&quot;],[0,&quot;de-DE&quot;],[0,&quot;es-ES&quot;],[0,&quot;fr-FR&quot;],[0,&quot;it-IT&quot;],[0,&quot;ja-JP&quot;],[0,&quot;ko-KR&quot;],[0,&quot;pt-BR&quot;],[0,&quot;ru-RU&quot;],[0,&quot;zh-CN&quot;]]],&quot;basepath&quot;:[0,&quot;&quot;]}" ssr client="deferred" opts="{&quot;name&quot;:&quot;NotFoundIsland&quot;,&quot;value&quot;:true}" await-children><style>#fern-toc,#fern-sidebar[data-state="sticky"],#fern-sidebar[data-state="fixed"],#fern-sidebar-spacer{visibility:hidden;width:0;overflow:hidden;display:none;}.fern-main:has(>#fern-sidebar[data-viewport="desktop"][data-state="sticky"]){min-height:0!important;}</style><div class="flex h-[calc(100svh-var(--header-height)-6rem)] w-screen flex-col items-center justify-center gap-6"><svg aria-hidden="true" focusable="false" role="img" class="h-[96px] w-[96px]" stroke-width="4" stroke="url(#404-border)"></svg><div class="flex flex-col text-center gap-2"><h1>Sorry, we couldn&#x27;t find that page</h1><p class="text-(color:--grayscale-a9)">We&#x27;ve been notified so we can fix this for next time.</p></div></div><!--astro:end--></astro-island></div><!-- Desktop sidebar (matches SidebarNav > DesktopMenu) --><aside id="fern-sidebar" data-viewport="desktop" data-state="sticky" data-custom-footer="true" class="fern-sidebar-desktop" tabindex="-1"><div data-astro-transition-persist="fern-sidebar-scroll-en-US-root" class="flex min-h-0 flex-1 flex-col"><nav aria-label="Sidebar navigation" class="flex min-h-0 flex-1 flex-col"><div id="fern-sidebar-static" class="flex min-h-0 flex-1 flex-col"></div></nav></div></aside><nav aria-label="Products" aria-hidden="true" inert class="absolute h-px w-px overflow-hidden [clip:rect(0,0,0,0)] whitespace-nowrap border-0 p-0" data-fern-style="margin:-1px"><ul><li><a href="/platform" tabindex="-1" aria-current="true">Platform</a></li><li><a href="/camera-to-cloud" tabindex="-1">Camera to Cloud</a></li></ul></nav><nav aria-label="Languages" aria-hidden="true" inert class="absolute h-px w-px overflow-hidden [clip:rect(0,0,0,0)] whitespace-nowrap border-0 p-0" data-fern-style="margin:-1px"><ul><li><a href="/" tabindex="-1" aria-current="true">English (US)</a></li><li><a href="/de-DE" tabindex="-1">Deutsch (Deutschland)</a></li><li><a href="/es-ES" tabindex="-1">Español (España)</a></li><li><a href="/fr-FR" tabindex="-1">Français (France)</a></li><li><a href="/it-IT" tabindex="-1">Italiano (Italia)</a></li><li><a href="/ja-JP" tabindex="-1">日本語 (日本)</a></li><li><a href="/ko-KR" tabindex="-1">한국어 (대한민국)</a></li><li><a href="/pt-BR" tabindex="-1">Português (BR)</a></li><li><a href="/ru-RU" tabindex="-1">Русский (Россия)</a></li><li><a href="/zh-CN" tabindex="-1">简体中文</a></li></ul></nav><script>
        (function () {
          // Runs on the initial load AND on every view-transition swap: Astro
          // re-inserts the `transition:persist`ed sidebar into the new document,
          // and re-inserting a scroll container resets its scrollTop to 0, so we
          // restore the position from sessionStorage before paint to avoid a
          // visible jump. The companion scroll listener below keeps that stored
          // value in lockstep with the live scroll (the hydrated build did this
          // via React); without it the restored value drifts stale and the
          // sidebar jumps to the wrong offset on navigation.
          try {
            var KEY = "fern-sidebar-scroll-position";
            var container = document.getElementById("fern-sidebar-scroll-area");
            if (!container) { return; }
            var storedRaw = window.sessionStorage.getItem(KEY);
            var stored = storedRaw != null ? parseInt(storedRaw, 10) : 0;
            if (Number.isFinite(stored) && stored > 0) {
              container.scrollTop = stored;
              return;
            }
            var active = container.querySelector('.fern-sidebar-link[data-state="active"]');
            if (!active) { return; }
            var cRect = container.getBoundingClientRect();
            var aRect = active.getBoundingClientRect();
            var isAbove = aRect.top < cRect.top;
            var isBelow = aRect.bottom > cRect.bottom;
            if (!isAbove && !isBelow) { return; }
            var offset = aRect.top - cRect.top + container.scrollTop;
            var target = Math.max(0, Math.round(offset - container.clientHeight / 3));
            container.scrollTop = target;
            if (target > 0) {
              window.sessionStorage.setItem(KEY, String(target));
            }
          } catch (e) { /* sessionStorage/layout unavailable — fall back to the hydration-time scroll */ }
        })();
